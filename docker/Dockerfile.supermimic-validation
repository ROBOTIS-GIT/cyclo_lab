FROM ghcr.io/astral-sh/uv:0.12.9@sha256:8b940d3a9d65bed080436972241af2e21c84b5e8c9193f7014ed71479ee795ff AS uv
FROM nvcr.io/nvidia/isaac-sim:6.2.0
USER root
COPY --from=uv /uv /usr/local/bin/uv
COPY third_party/IsaacLab /opt/IsaacLab
ENV VIRTUAL_ENV=/opt/isaaclab-venv UV_PROJECT_ENVIRONMENT=/opt/isaaclab-venv UV_PYTHON=/isaac-sim/kit/python/bin/python3 UV_PYTHON_PREFERENCE=only-system
RUN bash /opt/IsaacLab/docker/scripts/install_carb_env_shim.sh /isaac-sim
RUN ln -s /isaac-sim /opt/IsaacLab/_isaac_sim
RUN uv venv --seed /opt/isaaclab-venv && cd /opt/IsaacLab && uv sync --frozen --extra rsl-rl --extra ov --extra importers --no-install-package imageio-ffmpeg
RUN /opt/IsaacLab/isaaclab.sh -p -c 'from isaaclab.cli.commands.install import _repoint_prebundle_packages; _repoint_prebundle_packages()'
RUN uv pip install --python /opt/isaaclab-venv/bin/python pytest==9.2.0 tensordict==0.14.2 pyyaml GitPython prettytable
ENV PYTHONPATH=/workspace/cyclo_lab/source/cyclo_lab
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace/cyclo_lab
ENTRYPOINT ["/opt/IsaacLab/isaaclab.sh", "-p"]
